# Valores VITE são públicos e incorporados ao build. Nunca coloque segredos aqui.
# /api usa o proxy do Vite em desenvolvimento; produção exige proxy equivalente
# ou URL pública da API com CORS configurado.
VITE_API_URL=/api
# Somente no servidor de desenvolvimento, sem prefixo VITE.
API_PROXY_TARGET=http://127.0.0.1:8000
