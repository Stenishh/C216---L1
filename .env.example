# Valores de exemplo apenas para desenvolvimento local.
POSTGRES_DB=repara
POSTGRES_USER=repara
POSTGRES_PASSWORD=repara_local
DB_PORT=5432
# Python no host. Compose configura o host db internamente.
DATABASE_URL=postgresql+psycopg://repara:repara_local@127.0.0.1:5432/repara
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173
